{
  "name": "@helm/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Helm as a desktop app: the bridge, the cockpit, and a menu-bar kill switch.",
  "main": "build/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "dev:fast": "node scripts/build.mjs --skip-console && electron .",
    "dist": "node scripts/build.mjs --production && electron-builder --publish never",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.10",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
