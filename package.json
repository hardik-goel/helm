{
  "name": "helm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "helm": "concurrently -k -n bridge,console -c magenta,yellow \"pnpm --filter @helm/bridge dev\" \"pnpm --filter @helm/console dev\"",
    "bridge": "pnpm --filter @helm/bridge dev",
    "console": "pnpm --filter @helm/console dev",
    "build": "pnpm --filter @helm/console build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @helm/bridge db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
